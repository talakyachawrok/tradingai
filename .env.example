# ==============================================================================
# AI Trading Analyzer - Environment Configuration Template
# Copy this file to `.env` for local development (never commit `.env`).
# On Render / Vercel, configure these directly in the service dashboard.
# ==============================================================================

# --- Application & Render ---
APP_NAME=AI Trading Analyzer
APP_ENV=development
APP_HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Set FRONTEND_URL to your deployed Vercel URL in production (e.g. https://your-app.vercel.app)
FRONTEND_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Market Data Providers ---
# Supported providers: twelvedata, alphavantage, binance_public, webhook_cache, demo_historical
# Note: binance_public works for BTCUSD/BTCUSDT without API keys.
# Forex/Metals (XAUUSD, EURUSD, GBPUSD) require a live provider key (e.g., TWELVEDATA_API_KEY).
DEFAULT_DATA_PROVIDER=auto
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
STALE_DATA_THRESHOLD_SECONDS=900
MARKET_DATA_CACHE_TTL_SECONDS=30

# --- TradingView Webhook Integration (Optional) ---
TRADINGVIEW_WEBHOOK_SECRET=change-me-to-a-strong-random-secret
WEBHOOK_DEDUP_WINDOW_SECONDS=300

# --- AI Explanation Provider (Optional) ---
# Supported: none (deterministic grounded engine only), openai, gemini, anthropic, ollama
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- News / Economic Calendar Provider (Optional) ---
NEWS_PROVIDER=none
NEWS_FILTER_ENABLED=false
NEWS_BLACKOUT_MINUTES_BEFORE=30
NEWS_BLACKOUT_MINUTES_AFTER=15

# --- Frontend (Vercel / Local Vite) ---
# Leave blank locally to use Vite dev proxy, or set to your Render URL in production:
VITE_API_URL=https://analyzer-adts.onrender.com
