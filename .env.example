# ==============================================================================
# AI Trading Analyzer - Environment Configuration Template
# Copy this file to `.env` (never commit `.env` with real secrets).
# ==============================================================================

# --- Application ---
APP_NAME=AI Trading Analyzer
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (MongoDB primary, local SQLite JSON fallback if unavailable) ---
# Leave MONGODB_URI empty or unset if running without MongoDB; the backend will
# automatically use local persistent SQLite storage at LOCAL_DB_PATH and report it.
MONGODB_URI=
MONGODB_DB_NAME=ai_trading_analyzer
LOCAL_DB_PATH=./data/ai_trading_analyzer.db

# --- Market Data Providers ---
# Supported providers: twelvedata, alphavantage, binance_public, webhook_cache, demo_historical
# Note: binance_public works for BTCUSD/BTCUSDT without API keys when network is reachable.
# Forex/Metals (XAUUSD, EURUSD, GBPUSD) require a live provider key (e.g., TWELVEDATA_API_KEY).
DEFAULT_DATA_PROVIDER=auto
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
STALE_DATA_THRESHOLD_SECONDS=900

# --- TradingView Webhook Integration ---
# Set a strong random secret token and include it in your TradingView alert JSON payload
# or X-Webhook-Secret header.
TRADINGVIEW_WEBHOOK_SECRET=change-me-to-a-strong-random-secret
WEBHOOK_DEDUP_WINDOW_SECONDS=300

# --- AI Explanation Provider (Optional) ---
# Supported: none (deterministic grounded engine only), openai, gemini, anthropic, ollama
# The quantitative rules engine ALWAYS controls trade eligibility, scores, SL, and TP.
# The LLM only narrates structured computed facts.
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- News / Economic Calendar Provider (Optional) ---
# Supported: none, finnhub
NEWS_PROVIDER=none
NEWS_FILTER_ENABLED=false
NEWS_BLACKOUT_MINUTES_BEFORE=30
NEWS_BLACKOUT_MINUTES_AFTER=15

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
